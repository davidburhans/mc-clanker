# Dockerfile.worker - Generator worker container for mc-clanker
# Multi-stage build to minimize image size while including all dependencies

FROM python:3.10-slim as base

# Install system dependencies needed for audio processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install Python dependencies for worker
COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt

# Copy framework code (read-only, used for generation)
# These files are shared between main app and worker
COPY framework_generator.py framework_generator.py
COPY models_config.json models_config.json

# Copy Phase 1 infrastructure code
COPY garage_client.py garage_client.py
COPY aac_encoder.py aac_encoder.py

# Copy worker entry point
COPY worker.py worker.py

# Create non-root user for security (runs as UID 1000)
RUN useradd -m -u 1000 worker
USER worker

# Health check - verify ffmpeg is available
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ffmpeg -version > /dev/null 2>&1 || exit 1

# Default command runs the worker module
CMD ["python", "-m", "worker"]
