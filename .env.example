# .env.example — copy to .env and fill in your values
# Copy this file: cp .env.example .env

# =============================================================================
# REQUIRED — must be set for the app to function
# =============================================================================

# LLM Server — your OpenAI-compatible API endpoint (REQUIRED).
# This file ships NO default backend service. Pick one and set LLM_BASE_URL:
#   LM Studio : http://localhost:1234/v1
#   Ollama    : http://localhost:11434/v1
#   vLLM      : http://localhost:8001/v1  (run your own vLLM server + model)
# The previous default (http://vllm:8000/v1) pointed at a service that is not
# defined here, so first-run would fail to reach the LLM (review F8).
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=Qwen

# vLLM (optional): local path to your trained DPO model IF you run your own vLLM
# server with the DPO checkpoint. Ignored when using LM Studio/Ollama.
# For NVIDIA GPU: set to the absolute path of your model directory
# Example: DPO_MODEL_PATH=/path/to/your/model
# On Windows with Docker Desktop: mount path via docker settings
DPO_MODEL_PATH=../training/outputs/qwen3.5-0.8b-mc-clanker-dpo/final

# Garage S3 Object Storage
GARAGE_ENDPOINT=http://localhost:3900
GARAGE_ACCESS_KEY=your-access-key
GARAGE_SECRET_KEY=your-secret-key
GARAGE_BUCKET=mcclanker

# PostgreSQL (used by docker-compose)
POSTGRES_PASSWORD=change-me-in-production

# =============================================================================
# RECOMMENDED — set these for production
# =============================================================================

HF_TOKEN=your-hf-token

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=change-me-in-production

# Database (optional — uses SQLite if not set)
# DATABASE_URL=postgresql://user:pass@localhost:5432/mcclanker

# =============================================================================
# OPTIONAL — only needed for specific features
# =============================================================================

# DJ Password (required for DJ interface)
# DJ_PASSWORD=

# Audience Password (required for audience access)
# AUDIENCE_PASSWORD=

# ICECAST streaming (set to true to enable)
# ICECAST_ENABLED=false
