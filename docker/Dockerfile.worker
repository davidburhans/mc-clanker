# docker/Dockerfile.worker - GPU worker container for mc-clanker
# Single-stage: CUDA runtime + uv-managed venv from pyproject.toml worker group

FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    CUDA_HOME=/usr/local/cuda

WORKDIR /app

# Install Python + system packages (ffmpeg for audio processing)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-dev python3-pip \
    ffmpeg libpq5 curl git && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf /usr/bin/python3.10 /usr/bin/python

# Install uv (layer cached unless uv version changes)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Create virtual environment and install worker dependencies
# - uv venv creates .venv in /app
# - uv sync --group worker installs locked deps for GPU worker
# - --extra-index-url = CUDA index for GPU-enabled torch
COPY uv.lock pyproject.toml ./
RUN uv venv /app/.venv && \
    uv sync --frozen --group worker --extra-index-url https://download.pytorch.org/whl/cu124

# Copy source (this layer changes most often)
COPY app/ ./app/
COPY config/ ./config/

# Worker health probe (review F3) — process + DB reachability.
COPY docker/worker-healthcheck.sh /usr/local/bin/worker-healthcheck.sh
RUN chmod +x /usr/local/bin/worker-healthcheck.sh

# Health check — verifies the worker process is alive AND the database is
# reachable. The worker runs the generation loop directly (no HTTP server), so
# the in-process /api/worker/health endpoint is not curl-able from here; see
# docker/worker-healthcheck.sh for rationale.
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD /usr/local/bin/worker-healthcheck.sh || exit 1

# Use venv Python
CMD ["/app/.venv/bin/python", "-m", "app.worker"]
