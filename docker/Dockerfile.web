# docker/Dockerfile.web - FastAPI web application (CPU-only)
# Single-stage: slim Python + uv-managed venv from pyproject.toml

FROM python:3.10-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system packages first (shared base for all Python images)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libpq5 curl && \
    rm -rf /var/lib/apt/lists/*

# Install uv (layer cached unless uv version changes)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Create virtual environment and install dependencies
# - uv venv creates .venv in /app
# - uv sync installs locked deps into the venv
COPY uv.lock pyproject.toml ./
RUN uv venv /app/.venv && \
    uv sync --frozen

# Copy source (this layer changes most often)
COPY app/ ./app/
COPY config/ ./config/
COPY static/ ./static/
COPY migrations/ ./migrations/

# Create exports directory and non-root user
RUN mkdir -p /exports/shows && \
    useradd -m -u 1000 appuser

USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:4400/api/health')" || exit 1

# Use venv Python
CMD ["/app/.venv/bin/python", "-m", "uvicorn", "app.app_ui:app", "--host", "0.0.0.0", "--port", "4400"]
